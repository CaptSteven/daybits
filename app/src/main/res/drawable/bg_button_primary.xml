<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/button_ripple_light">
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#334F7E8A" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <gradient
                        android:angle="135"
                        android:endColor="@color/button_primary_end"
                        android:startColor="@color/button_primary_start" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/button_primary_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
