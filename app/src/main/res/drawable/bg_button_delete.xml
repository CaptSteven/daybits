<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/button_ripple_dark">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:endColor="@color/button_delete_end"
                android:startColor="@color/button_delete_start" />
            <stroke
                android:width="1dp"
                android:color="@color/button_delete_stroke" />
        </shape>
    </item>
</ripple>
